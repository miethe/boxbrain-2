  "description": "Intent→transport routing table for the ccdash skill. Covers both MCP tools and CLI commands. Update this file and CHANGELOG.md whenever the query surface changes.",
  "intents": [
    {
      "id": "container-project-onboarding",
      "intent_pattern": "prepare projects.json | container project onboarding | generate watcher env | watcher binding | bind worker-watch to project | live-watch project setup | healthy container stack shows no data",
      "command": "python3 backend/scripts/container_project_onboarding.py --projects-file projects.json --project-id <project_id> --name <name> --root-container <container_path> [--sessions-container <container_sessions_path>] [--watcher-env deploy/runtime/watchers/<project>.env]",
      "default_output": "human",
      "provenance_fields": ["project_id", "projects_file", "watcher_env", "root_container", "sessions_container", "watcher_probe_port"],
      "recipe": "recipes/container-project-onboarding.md",
      "reference": "references/container-project-onboarding.md",
      "transport": ["shell"],
      "flags": ["--project-id ID", "--name NAME", "--root-container PATH", "--plan-docs PATH", "--sessions-container PATH", "--progress PATH", "--watcher-env PATH", "--watcher-probe-port PORT", "--no-active"],
      "notes": "Host-side deployment input preparation only. Does not start, scale, or rebind running watcher containers; worker-watch binds one project at startup via CCDASH_WORKER_WATCH_PROJECT_ID."
    },
    {
      "id": "project-status",
      "intent_pattern": "project status | how is the project | what's the state of this project | overall health | project summary",
      "command": "ccdash status project",
      "default_output": "json",
      "provenance_fields": ["project_id", "generated_at", "feature_ids", "active_session_ids"],
      "recipe": "recipes/project-triage.md",
      "transport": ["mcp", "cli"],
      "mcp_tool": "ccdash_project_status",
      "flags": ["--timeout N", "--json", "--md", "--output {human|json|markdown}", "--no-cache"]
    },
    {
