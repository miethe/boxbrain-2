      "default_output": "human",
      "provenance_fields": ["target", "url", "reachable", "authenticated"],
      "recipe": "recipes/unreachable-server.md",
      "transport": ["cli"],
      "flags": ["--timeout N", "--json", "--md", "--output {human|json|markdown}"]
    },
