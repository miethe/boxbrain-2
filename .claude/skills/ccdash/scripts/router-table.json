    {
      "id": "session-search",
      "intent_pattern": "search session transcripts | find where agent said X | grep sessions | search sessions in project",
      "command": "ccdash session search <query> [--project PROJECT] [--feature FEATURE] [--limit N]",
      "default_output": "json",
      "provenance_fields": ["session_id", "match_line", "feature_id", "timestamp"],
      "transport": ["mcp", "cli"],
      "mcp_tool": "ccdash_session_search",
      "flags": ["--project PROJECT", "--feature FEATURE", "--limit N", "--offset N", "--timeout N", "--json", "--md", "--output {human|json|markdown}"],
      "notes": "project_id required for MCP tool; optional (active-project fallback) for repo-CLI. Min 2-char query. MCP default limit 25, max 100."
    },
    {
      "id": "session-detail",
      "intent_pattern": "session full detail | transcript-bearing session | get session with transcript | cross-project session detail | session tokens subagents artifacts links",
      "command": "ccdash session get <session_id> --project <project_id> [--include SEG]... [--cursor CUR] [--limit N]",
      "default_output": "json",
      "provenance_fields": ["session_id", "project_id", "transcript", "tokens", "subagents", "artifacts", "links", "redactedFieldCount"],
      "transport": ["mcp", "cli"],
      "mcp_tool": "ccdash_session_detail",
      "reference": "references/command-session.md",
      "flags": ["--project PROJECT (required)", "--include SEG (repeatable)", "--cursor CUR", "--limit N", "--timeout N", "--json", "--md", "--output {human|json|markdown}"],
      "notes": "project_id required for both MCP and CLI. No active-project fallback. Redaction applied by Phase 1 service before egress on all transports. Transcript cursor-paginated via nextCursor. MCP default limit 50, max 200. Service limit max 1000."
    },
    {
      "id": "session-transcript",
      "intent_pattern": "session transcript page | paginate transcript | next page of transcript | read transcript cursor",
      "command": "ccdash session transcript <session_id> --project <project_id> [--cursor CUR] [--limit N]",
