      "flags": ["--project PROJECT (required)", "--cursor CUR", "--limit N", "--timeout N", "--json", "--md", "--output {human|json|markdown}"],
      "notes": "project_id required for both MCP and CLI. Transcript-only page; use nextCursor for subsequent pages. MCP byte ceiling 1 MiB; meta.truncated=true when trimmed."
    },
