<script>
 import {matches,isContentUrl} from '../lib/filters.mjs';
 const form=document.querySelector('#filters');
 if(form instanceof HTMLFormElement){const params=new URLSearchParams(location.search);for(const el of form.elements){if(el instanceof HTMLInputElement && el.name==='q')el.value=params.get('q')||'';if(el instanceof HTMLInputElement && el.type==='checkbox')el.checked=params.getAll(el.name).includes(el.value);if(el instanceof HTMLSelectElement)for(const option of el.options)option.selected=!!option.value && params.getAll(el.name).includes(option.value);}const apply=()=>{const data=new FormData(form);const selected=(name)=>data.getAll(name).map(String).filter(Boolean);const filters={q:String(data.get('q')||''),kinds:selected('kind'),offerings:selected('offering'),tags:selected('tag')};let count=0;document.querySelectorAll('[data-item]').forEach((el)=>{if(!(el instanceof HTMLElement)) return;const show=matches({text:el.dataset.text||'',kind:el.dataset.kind||'',offerings:JSON.parse(el.dataset.offerings||'[]'),tags:JSON.parse(el.dataset.tags||'[]')},filters);el.hidden=!show;if(show)count++;});const query=new URLSearchParams();for(const [key,values] of [['q',[filters.q]],['kind',filters.kinds],['offering',filters.offerings],['tag',filters.tags]])for(const value of values)if(value)query.append(key,value);history.replaceState(null,'',location.pathname+(query.size?'?'+query:''));const status=document.querySelector('#filter-status');if(status)status.textContent=count?`${count} results`:'No results. Clear filters to browse all resources.';};form.addEventListener('input',apply);form.addEventListener('reset',()=>setTimeout(apply));apply();}
 const input=document.querySelector('#site-search');if(input instanceof HTMLInputElement){let index;input.addEventListener('input',async()=>{const status=document.querySelector('#search-status'),results=document.querySelector('#search-results');if(!status||!results)return;results.replaceChildren();if(!input.value){status.textContent='';return;}status.textContent='Loading search…';try {const indexUrl='/pagefind/pagefind.js';index ||= await import(/* @vite-ignore */ indexUrl);const found=await index.search(input.value);let count=0;for(const result of found.results){const data=await result.data();if(!data.url.startsWith(location.pathname)||!isContentUrl(data.url))continue;const li=document.createElement('li'),a=document.createElement('a');a.href=data.url;a.textContent=data.meta.title||data.url;li.append(a);results.append(li);count++;}status.textContent=`${count} results`;}catch{status.textContent='Search unavailable. Try again or browse the links.';}});}
</script>

