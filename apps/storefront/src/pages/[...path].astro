---
import Layout from '../layouts/Layout.astro';
import {items, lookup, practice, url, edition} from '../lib/site.mjs';
export function getStaticPaths() {
 const routes=[{params:{path:undefined},props:{kind:'index'}}];
 for(const p of items.filter(x=>x.type==='practice')) {
  routes.push({params:{path:`practices/${p.slug}`},props:{kind:'home',p}});
  for(const kind of ['offerings','plays','library']) if(kind!=='plays'||p.play_ids.length) routes.push({params:{path:`practices/${p.slug}/${kind}`},props:{kind,p}});
  for(const o of items.filter(x=>x.practice_id===p.id)) { const canonical=url(o).slice(1,-1); routes.push({params:{path:canonical},props:{kind:'detail',p,o}}); for(const practiceSlug of [p.slug,...p.aliases]) for(const itemSlug of [o.slug,...o.aliases]) {const oldPath=canonical.replace(`practices/${p.slug}/`,`practices/${practiceSlug}/`).replace(/[^/]+$/,itemSlug); if(oldPath!==canonical) routes.push({params:{path:oldPath},props:{kind:'redirect',p,o}}); } }
  for(const alias of p.aliases) { routes.push({params:{path:`practices/${alias}`},props:{kind:'redirect',p,o:p}}); for(const section of ['offerings','plays','library']) if(section!=='plays'||p.play_ids.length) routes.push({params:{path:`practices/${alias}/${section}`},props:{kind:'redirect',p,redirect:`/practices/${p.slug}/${section}/`}}); }
 }
 return routes;
}
const {kind,p,o,redirect}=Astro.props;
const owned=(type)=>items.filter(x=>x.practice_id===p?.id && x.type===type);
const ordered=(ids)=>ids.map(lookup).filter(Boolean);
const links=(arr)=>arr.map(x=>({title:x.title,url:url(x)}));
const list=kind==='offerings'?ordered(p.offering_ids):kind==='plays'?ordered(p.play_ids):kind==='library'?owned('collateral'):[];
const related=o?.type==='offering'?owned('collateral').filter(x=>x.offering_ids.includes(o.id)):[];
const relatedPlays=o?.type==='offering'?owned('play').filter(x=>x.offering_ids.includes(o.id)):[];
const title=o?.title || (kind==='redirect'?'Page moved':kind==='home'?p.title:kind==='index'?'Practices':kind[0].toUpperCase()+kind.slice(1));
---
<Layout {title} practice={p} plays={!!p?.play_ids.length} {edition}>
{kind==='redirect' && <meta http-equiv="refresh" content={`0; url=${redirect || url(o)}`} />}
<h1>{title}</h1>{kind==='redirect' && <p>Moved to <a href={redirect || url(o)}>{o?.title || "the new page"}</a>.</p>}
{kind==='index' && <ul>{items.filter(x=>x.type==='practice').map(x=><li><a href={url(x)}>{x.title}</a> — {x.summary} ({x.offering_ids.length} offerings)</li>)}</ul>}
{kind==='home' && <><p>{p.tagline}</p><p>{p.summary}</p><div set:html={p.html}/>{p.situations.length>0 && <section><h2>Explore by situation</h2><ul>{p.situations.map(s=><li><a href={url(lookup(s.offering_id))}>{s.label}</a></li>)}</ul></section>}<section><h2>Offerings</h2><ul>{links(ordered(p.offering_ids)).map(x=><li><a href={x.url}>{x.title}</a></li>)}</ul></section>{p.play_ids.length>0 && <section><h2>Plays</h2><ul>{links(ordered(p.play_ids)).map(x=><li><a href={x.url}>{x.title}</a></li>)}</ul></section>}{p.featured_collateral_ids.length>0 && <section><h2>Evidence</h2><ul>{links(ordered(p.featured_collateral_ids)).map(x=><li><a href={x.url}>{x.title}</a></li>)}</ul></section>}<section><h2>Search this practice</h2><label>Search <input id="site-search" type="search" /></label><p id="search-status" aria-live="polite"></p><ul id="search-results"></ul><noscript>Search requires JavaScript; browse using the links above.</noscript></section></>}
{['offerings','plays','library'].includes(kind) && <>{kind==='library' && <><form id="filters"><label>Search <input name="q" type="search" /></label><label>Kind <select name="kind" multiple><option value="">All</option>{[...new Set(list.map(x=>x.kind))].map(x=><option>{x}</option>)}</select></label><label>Offering <select name="offering" multiple><option value="">All</option>{ordered(p.offering_ids).map(x=><option value={x.id}>{x.title}</option>)}</select></label><label>Tag <select name="tag" multiple><option value="">All</option>{[...new Set(list.flatMap(x=>x.tags))].map(x=><option>{x}</option>)}</select></label><button type="reset">Clear filters</button></form><p id="filter-status" aria-live="polite"></p></>}<ul id="browse-list">{list.map(x=><li data-item data-kind={x.kind} data-offerings={JSON.stringify(x.offering_ids)} data-tags={JSON.stringify(x.tags)} data-text={`${x.title} ${x.summary} ${x.body}`.toLowerCase()}><a href={url(x)}>{x.title}</a> — {x.summary} {x.kind && `(${x.kind}, ${x.format}; reviewed ${x.reviewed_on})`}</li>)}</ul>{list.length===0 && <p>No published resources yet.</p>}</>}
{kind==='detail' && <><p>{o.summary}</p><div set:html={o.html}/>{o.type==='offering' && <><section><h2>Outcomes</h2><ul>{o.outcomes.map(x=><li>{x}</li>)}</ul><h2>Good fit</h2><ul>{o.good_fit.map(x=><li>{x}</li>)}</ul><h2>Not a fit</h2><ul>{o.not_fit.map(x=><li>{x}</li>)}</ul></section>{o.guide && <section><h2>How to sell it</h2><div set:html={o.guide.html}/></section>}{related.length>0 && <section><h2>Evidence and resources</h2><ul>{links(related).map(x=><li><a href={x.url}>{x.title}</a></li>)}</ul></section>}{relatedPlays.length>0 && <section><h2>Related plays</h2><ul>{links(relatedPlays).map(x=><li><a href={x.url}>{x.title}</a></li>)}</ul></section>}</>}{o.type==='play' && <><p>{o.trigger}</p><h2>Offerings</h2><ul>{links(ordered(o.offering_ids)).map(x=><li><a href={x.url}>{x.title}</a></li>)}</ul><h2>Stages</h2><ol>{o.stages.map(s=><li><h3>{s.title}</h3><p>{s.action}</p><p>{s.exit_criterion}</p><ul>{links(ordered(s.collateral_ids)).map(x=><li><a href={x.url}>{x.title}</a></li>)}</ul></li>)}</ol></>}{o.type==='collateral' && <><p>{o.kind} · {o.format} · Reviewed {o.reviewed_on} by {o.reviewed_by}</p><p>{o.external_url?<a href={o.external_url} target="_blank" rel="noopener noreferrer">Open external link</a>:<a href={`/assets/${p.slug}/${o.asset_path.split('/').pop()}`}>Download {o.format==='markdown'?'Markdown source':o.format.toUpperCase()}</a>}</p><h2>Related offerings</h2><ul>{links(ordered(o.offering_ids)).map(x=><li><a href={x.url}>{x.title}</a></li>)}</ul></>}</>}
</Layout>
<script>
 import {matches} from '../lib/filters.mjs';
 const form=document.querySelector('#filters');
 if(form instanceof HTMLFormElement){const params=new URLSearchParams(location.search);for(const el of form.elements){if(el instanceof HTMLInputElement && el.name==='q')el.value=params.get('q')||'';if(el instanceof HTMLSelectElement)for(const option of el.options)option.selected=!!option.value && params.getAll(el.name).includes(option.value);}const apply=()=>{const data=new FormData(form);const selected=(name)=>data.getAll(name).map(String).filter(Boolean);const filters={q:String(data.get('q')||''),kinds:selected('kind'),offerings:selected('offering'),tags:selected('tag')};let count=0;document.querySelectorAll('[data-item]').forEach((el)=>{if(!(el instanceof HTMLElement)) return;const show=matches({text:el.dataset.text||'',kind:el.dataset.kind||'',offerings:JSON.parse(el.dataset.offerings||'[]'),tags:JSON.parse(el.dataset.tags||'[]')},filters);el.hidden=!show;if(show)count++;});const query=new URLSearchParams();for(const [key,values] of [['q',[filters.q]],['kind',filters.kinds],['offering',filters.offerings],['tag',filters.tags]])for(const value of values)if(value)query.append(key,value);history.replaceState(null,'',location.pathname+(query.size?'?'+query:''));const status=document.querySelector('#filter-status');if(status)status.textContent=count?`${count} results`:'No results. Clear filters to browse all resources.';};form.addEventListener('input',apply);form.addEventListener('reset',()=>setTimeout(apply));apply();}
 const input=document.querySelector('#site-search');if(input instanceof HTMLInputElement){let index;input.addEventListener('input',async()=>{const status=document.querySelector('#search-status'),results=document.querySelector('#search-results');if(!status||!results)return;results.replaceChildren();if(!input.value){status.textContent='';return;}status.textContent='Loading search…';try {const indexUrl='/pagefind/pagefind.js';index ||= await import(/* @vite-ignore */ indexUrl);const found=await index.search(input.value);let count=0;for(const result of found.results){const data=await result.data();if(!data.url.startsWith(location.pathname))continue;const li=document.createElement('li'),a=document.createElement('a');a.href=data.url;a.textContent=data.meta.title||data.url;li.append(a);results.append(li);count++;}status.textContent=`${count} results`;}catch{status.textContent='Search unavailable. Try again or browse the links.';}});}
</script>
