---
import Shell from '../v2/Shell.astro';
import Card from '../v2/Card.astro';
import Icon from '../v2/Icon.astro';
const {vm}=Astro.props;
const {p,title,ordered,lookup,url,slots}=vm;
---
<Shell {vm}>
<p class="eyebrow">Seller field guide / {p.title}</p><h1>{title}</h1><p class="lede">{p.tagline} {p.summary}</p>
{slots.doorway.length>0 && <section class="doorway"><p class="eyebrow">Find a starting point</p><h2>What is your client trying to fix?</h2><ul class="doorway-links">{slots.doorway.map(s=><li><a href={url(lookup(s.offering_id))}><Icon name="target"/><span>{s.label}</span><Icon name="arrow"/></a></li>)}</ul></section>}
{p.play_ids.length>0 && <section><div class="section-heading"><div><p class="eyebrow">Start a conversation</p><h2>Plays</h2></div><a href={`/practices/${p.slug}/plays/`}>All plays →</a></div><ol class="play-flow">{ordered(p.play_ids).map((x,i)=><li><a href={url(x)}><span class="step-number">{i+1}</span><span class="flow-icon"><Icon name="play"/></span><span class="chip">Play</span><h3>{x.title}</h3><p>{x.summary}</p><Icon name="arrow"/></a></li>)}</ol></section>}
{slots.evidence.length>0 && <section><div class="section-heading"><div><p class="eyebrow">For your next conversation</p><h2>Ready to use</h2></div><a href={`/practices/${p.slug}/library/`}>Browse the library →</a></div><ul class="link-list">{slots.evidence.map(x=><li><Card item={x} href={url(x)} tile/></li>)}</ul></section>}
<section><p class="eyebrow">Explore the practice</p><h2>Offerings</h2><ul class="link-list">{ordered(p.offering_ids).map(x=><li><Card item={x} href={url(x)} type="offering"/></li>)}</ul></section><section><div set:html={p.html}/></section>
</Shell>
