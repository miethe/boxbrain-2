# BoxBrain v2 local environment example

APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL + pgvector
POSTGRES_USER=boxbrain
POSTGRES_PASSWORD=boxbrain
POSTGRES_DB=boxbrain
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://boxbrain:boxbrain@localhost:5432/boxbrain

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage
MINIO_ROOT_USER=boxbrain
MINIO_ROOT_PASSWORD=boxbrain-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=boxbrain-artifacts
S3_ACCESS_KEY_ID=boxbrain
S3_SECRET_ACCESS_KEY=boxbrain-secret
S3_REGION=us-east-1

# Auth can be stubbed locally. Use OIDC variables for pilot/prod.
AUTH_MODE=dev
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# AI/embeddings. Keep empty until provider is selected.
AI_PROVIDER=
AI_MODEL_SUMMARY=
AI_MODEL_EMBEDDINGS=
AI_API_KEY=

# Ingestion/rendering
INGESTION_MAX_UPLOAD_MB=100
RENDER_TIMEOUT_SECONDS=120
LIBREOFFICE_BIN=soffice

# Optional OpenSearch profile
OPENSEARCH_PORT=9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=boxbrain-Admin-123!

# Telemetry
ENABLE_PRODUCT_TELEMETRY=true
ENABLE_SEARCH_DEBUG=true
